#!/usr/bin/env python
"""Validate Roadock commit message format."""

import re
import subprocess
import sys
from pathlib import Path

SUBJECT = re.compile(
    r"^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)"
    r"(?:\([a-z][a-z0-9]*(?:-[a-z0-9]+)*\))?: .*[가-힣].*$"
)
TRAILER = re.compile(r"^[A-Za-z][A-Za-z0-9-]*(?: [A-Za-z][A-Za-z0-9-]*)?: \S")


def validate(message, merge=False):
    lines = []
    for line in message.splitlines():
        if re.match(r"^# *-+ *>8 *-+", line):
            break
        if not line.startswith("#"):
            lines.append(line.rstrip())
    while lines and not lines[0]:
        lines.pop(0)
    if not lines:
        return []  # Git rejects empty messages.
    if merge or lines[0].startswith(("fixup! ", "squash! ", "amend! ", "Revert ")):
        return []
    errors = []
    if not SUBJECT.fullmatch(lines[0]):
        errors.append("제목: type(scope): 한글 제목 (scope 생략 가능, 소문자 영문 kebab-case, ! 금지)")
    if len(lines) > 1 and lines[1].strip():
        errors.append("제목 뒤에 빈 줄을 둔다")
    body = [line for line in lines[2:] if line.strip()]
    if any(not line.startswith("- ") and not TRAILER.match(line) for line in body):
        errors.append("본문 항목은 '- '로 시작한다")
    body_started = False
    trailer_started = False
    previous = ""
    spacing_error = False
    trailer_separator_error = False
    trailer_order_error = False
    for line in lines[2:]:
        if line.startswith("- "):
            if trailer_started:
                trailer_order_error = True
            elif body_started and not previous.strip():
                spacing_error = True
            body_started = True
        elif TRAILER.match(line):
            if body_started and not trailer_started and previous.strip():
                trailer_separator_error = True
            trailer_started = True
        previous = line
    if spacing_error:
        errors.append("본문 항목 사이에 빈 줄을 넣지 않는다")
    if trailer_separator_error:
        errors.append("Git trailer 앞에 빈 줄을 둔다")
    if trailer_order_error:
        errors.append("Git trailer 뒤에 본문을 쓰지 않는다")
    if lines[0].endswith((".", "。")) or any(
        line.startswith("- ") and line.endswith((".", "。")) for line in body
    ):
        errors.append("제목과 본문 항목 끝에 마침표를 쓰지 않는다")
    return errors


def main(path):
    result = subprocess.run(
        ["git", "rev-parse", "--git-path", "MERGE_HEAD"],
        capture_output=True, text=True, check=True,
    )
    errors = validate(Path(path).read_text(encoding="utf-8"), Path(result.stdout.strip()).exists())
    if errors:
        sys.stderr.write("commit-msg: " + "\n".join(errors) + "\n")
    return int(bool(errors))


if __name__ == "__main__":
    sys.stderr.reconfigure(encoding="utf-8")
    sys.exit(main(sys.argv[1]))
