<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Launch" parent="AppTheme">
        <item name="android:windowBackground">@color/icon_background</item>
    </style>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="fontFamily">@font/roadock_sans</item>
        <item name="android:fontFamily">@font/roadock_sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#101010</item>
        <item name="android:colorBackground">#101010</item>
        <item name="colorSurface">#101010</item>
        <item name="colorSurfaceContainerLowest">#101010</item>
        <item name="colorSurfaceContainerLow">#1C1C1C</item>
        <item name="colorSurfaceContainer">#1C1C1C</item>
        <item name="colorSurfaceContainerHigh">#242424</item>
        <item name="colorSurfaceContainerHighest">#2C2C2C</item>
        <item name="colorOnSurface">#ECECEC</item>
        <item name="colorOnSurfaceVariant">#A6A6A6</item>
        <item name="colorOutline">#707070</item>
        <item name="colorOutlineVariant">#343434</item>
        <item name="colorPrimary">#ECECEC</item>
        <item name="colorOnPrimary">#101010</item>
        <item name="colorPrimaryContainer">#343434</item>
        <item name="colorOnPrimaryContainer">#ECECEC</item>
        <item name="colorSecondary">#C8C8C8</item>
        <item name="colorOnSecondary">#101010</item>
        <item name="colorSecondaryContainer">#343434</item>
        <item name="colorOnSecondaryContainer">#ECECEC</item>
        <item name="colorError">#F2B8B5</item>
        <item name="android:colorAccent">#ECECEC</item>
        <item name="materialAlertDialogTheme">@style/Roadock.Dialog</item>
        <item name="tabStyle">@style/Roadock.Tabs</item>
        <item name="sliderStyle">@style/Roadock.Slider</item>
    </style>
    <style name="Roadock.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="fontFamily">@font/roadock_sans</item>
        <item name="android:fontFamily">@font/roadock_sans</item>
        <item name="dialogPreferredPadding">24dp</item>
        <item name="materialAlertDialogTitlePanelStyle">@style/Roadock.DialogTitlePanel</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Roadock.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Roadock.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Roadock.DialogAction</item>
        <item name="buttonBarNegativeButtonStyle">@style/Roadock.DialogSecondaryAction</item>
    </style>
    <style name="Roadock.DialogTitlePanel" parent="MaterialAlertDialog.Material3.Title.Panel">
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="Roadock.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="fontFamily">@font/pretendard_semibold</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Roadock.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="fontFamily">@font/pretendard_regular</item>
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Roadock.DialogAction" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Roadock.DialogSecondaryAction" parent="Roadock.DialogAction">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Roadock.WidgetSection" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:fontFamily">@font/roadock_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10dp</item>
        <item name="android:textColor">#909090</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Roadock.WidgetLabel" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:fontFamily">@font/roadock_sans</item>
        <item name="android:textSize">12dp</item>
        <item name="android:textColor">#C8C8C8</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">10dp</item>
    </style>
    <style name="Roadock.WidgetRowText" parent="Roadock.WidgetLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="Roadock.Slider" parent="Widget.MaterialComponents.Slider">
        <item name="trackHeight">4dp</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorOutlineVariant</item>
        <item name="thumbWidth">16dp</item>
        <item name="thumbHeight">16dp</item>
        <item name="thumbElevation">0dp</item>
        <item name="tickVisibilityMode">hidden</item>
    </style>
    <style name="Roadock.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/Roadock.TabLabel</item>
        <item name="tabTextColor">#A6A6A6</item>
        <item name="tabSelectedTextColor">#ECECEC</item>
        <item name="tabIndicatorColor">#ECECEC</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabPaddingStart">16dp</item>
        <item name="tabPaddingEnd">16dp</item>
        <item name="tabMinWidth">80dp</item>
        <item name="tabRippleColor">#20FFFFFF</item>
    </style>
    <style name="Roadock.TabLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
