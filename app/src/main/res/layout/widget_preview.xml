<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="@string/previous_symbol"
                android:fontFamily="@font/roadock_sans" android:textSize="24dp" android:gravity="center" android:textColor="#505050" />
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="@string/widget_sample_title" android:fontFamily="@font/pretendard_semibold"
                android:textSize="18dp" android:textColor="#ECECEC" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" android:gravity="center" />
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="@string/next_symbol"
                android:fontFamily="@font/roadock_sans" android:textSize="24dp" android:gravity="center" android:textColor="#A6A6A6" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_preview_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_check_done"
                    android:importantForAccessibility="no" />
                <TextView style="@style/Roadock.WidgetRowText" android:text="@string/widget_sample_build" android:textColor="#909090" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_check_empty"
                    android:importantForAccessibility="no" />
                <TextView style="@style/Roadock.WidgetRowText" android:text="@string/widget_sample_errors" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_check_empty"
                    android:importantForAccessibility="no" />
                <TextView style="@style/Roadock.WidgetRowText" android:text="@string/widget_sample_test" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
