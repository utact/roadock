<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp"
        android:text="@string/previous_symbol" android:fontFamily="@font/roadock_sans" android:textSize="24dp"
        android:gravity="center" android:textColor="#505050" android:contentDescription="@string/previous_project" />
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1" android:fontFamily="@font/pretendard_semibold" android:text="@string/app_name"
        android:textColor="#ECECEC" android:textSize="18dp" android:maxLines="1" android:ellipsize="end"
        android:includeFontPadding="false" android:gravity="center" android:contentDescription="@string/open_app" />
    <TextView android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp"
        android:text="@string/next_symbol" android:fontFamily="@font/roadock_sans" android:textSize="24dp"
        android:gravity="center" android:textColor="#A6A6A6" android:contentDescription="@string/next_project" />
</LinearLayout>
